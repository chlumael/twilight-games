// 황혼 게임즈 서버(Firestore) 보안 규칙 — Firebase 콘솔 → Firestore Database → 규칙에 이 내용을 그대로 붙여 넣고 "게시".
// 뜻:
//  · users/{uid}/… : 로그인한 본인만 자기 기록을 읽고 쓴다.
//  · shares/{uid}  : 친구 탭(DESIGN.md §8.5). 공유를 켠 사람의 요약(닉네임·뽑기 수·운 등)만 있다.
//                    로그인한 사람은 모두 읽을 수 있고, 본인 것만 쓰고 지운다.
//  · 그 밖의 모든 접근은 막는다(예전 그룹 방식 groups/…도 이제 막힌다).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /shares/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["data", "updatedAt"])
        && request.resource.data.data is string && request.resource.data.data.size() < 100000
        && request.resource.data.updatedAt is string;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
  }
}
