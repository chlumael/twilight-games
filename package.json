{
  "name": "twilight-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "tauri": "tauri",
    "banners": "node scripts/banners/build.mjs && node scripts/banners/validate.mjs",
    "build:web": "WEB_BASE=/twilight-games/ vite build",
    "build:android": "WEB_BASE=./ vite build --outDir android/app/src/main/assets/web --emptyOutDir"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2.12.6",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^22.20.5",
    "json5": "^2.2.3",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "firebase": "^11.10.0"
  }
}
